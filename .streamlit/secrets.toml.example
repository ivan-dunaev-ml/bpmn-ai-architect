# Настройки LLM. Amvera / Streamlit Cloud: раздел Secrets (вставить текст целиком).
# Локально: скопировать в .streamlit/secrets.toml (файл в .gitignore, не коммитить!).
# app.py передаёт эти ключи в переменные окружения, их читает llm_providers.py.

# --- Режим: auto (Яндекс, если задан ключ, затем облака) | yandex | cloud | emulator ---
# BPMN_PROVIDER = "auto"

# --- Финал: стек технологического партнёра — Yandex AI Studio (OpenAI-совместимый API) ---
# Переключение — только эти значения, код не меняется. Для финала: BPMN_PROVIDER = "yandex".
# YANDEX_API_KEY = "AQVN..."                 # API-ключ сервисного аккаунта (или YANDEX_IAM_TOKEN)
# YANDEX_FOLDER_ID = "b1g..."                # каталог сервисного аккаунта
# YANDEX_MODEL = "yandexgpt/latest"          # или yandexgpt-lite/latest, или полный gpt://<folder>/<model>/latest
# YANDEX_INPUT_BUDGET = "24000"              # потолок промпта, токенов

# --- Основной: Groq, GPT-OSS 120B (бесплатный ключ: https://console.groq.com/keys) ---
# Groq Free: 8K токенов на запрос и в минуту — бюджет промпта считается автоматически (llm_providers.py).
OPENAI_API_KEY = "gsk_..."
OPENAI_BASE_URL = "https://api.groq.com/openai/v1"
OPENAI_MODEL = "openai/gpt-oss-120b"
OPENAI_REASONING_EFFORT = "low"

# --- Запасные провайдеры (по порядку, если основной отказал: HTTP 403 / 429 / 413 / таймаут) ---
# По правилам хакатона — только open-source модели (ChatGPT, Gemini запрещены).
# 1) Второй ключ Groq (свой лимит 8K токенов/мин):
# FALLBACK_API_KEY = "gsk_..."
# FALLBACK_BASE_URL = "https://api.groq.com/openai/v1"
# FALLBACK_MODEL = "openai/gpt-oss-120b"
# FALLBACK_REASONING_EFFORT = "low"
# 2) OpenRouter, NVIDIA Nemotron 3 Super 120B (открытые веса), бесплатно (ключ: https://openrouter.ai/settings/keys).
#    qwen/qwen3.8-27b:free удалена с OpenRouter (HTTP 404). Без «размышлений»: ~10 с, иначе код обрезается.
# FALLBACK2_API_KEY = "sk-or-..."
# FALLBACK2_BASE_URL = "https://openrouter.ai/api/v1"
# FALLBACK2_MODEL = "nvidia/nemotron-3-super-120b-a12b:free"
# FALLBACK2_REASONING_EFFORT = "none"
# FALLBACK2_MAX_TOKENS = "8192"

# Без ключей сервис работает на встроенном семантическом разборе (эмулятор), без сети.
