+    sel = (catalog or {}).get(selected_id) if selected_id else None
+    if sel is not None and _HIGHLIGHT_ONE_RE.search(message):
+        return highlight_reply([], sel, one=True)
+    return highlight_reply(highlight_items(ctx))
+
