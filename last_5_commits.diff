+    r"верни\w*\s+(?:\w+\s+){0,2}?(?:прежн|исходн|старую)\w*\s+рол",
+    re.I,
+)
+_TRANSFER_STOP_ROOTS = {"систем", "инфор", "шаг", "роль", "смен", "возмо", "таких", "перед"}
+_ROLE_GENERIC_ROOTS = {"служб", "отдел", "управ", "депар", "групп"}
