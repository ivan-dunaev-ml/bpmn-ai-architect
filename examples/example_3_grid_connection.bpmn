    <bpmn:sequenceFlow id="Flow_17" sourceRef="Activity_9" targetRef="Activity_10" />
    <bpmn:sequenceFlow id="Flow_18" name="Договор подписан" sourceRef="Gateway_2" targetRef="Gateway_3" />
    <bpmn:sequenceFlow id="Flow_19" name="Отказ заявителя" sourceRef="Gateway_2" targetRef="Event_3" />
    <bpmn:sequenceFlow id="Flow_20" sourceRef="Gateway_4" targetRef="Activity_13" />
    <bpmn:sequenceFlow id="Flow_21" name="Замечаний нет" sourceRef="Gateway_5" targetRef="Activity_14" />
    <bpmn:sequenceFlow id="Flow_22" name="Замечания к ТУ" sourceRef="Gateway_5" targetRef="Gateway_3" />
    <bpmn:sequenceFlow id="Flow_23" sourceRef="Activity_14" targetRef="Activity_15" />
